{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "model": "openrouter/deepseek/deepseek-v4-pro",
  "small_model": "openrouter/deepseek/deepseek-v4-flash",
  "agent": {
    "grok-reviewer": {
      "description": "エロ伝道師レビュアー（Grok）。台本・芯・prompt・transcript をアダルト品質の観点で採点して直言する。実装 diff や生成会話を渡すと使う",
      "mode": "subagent",
      "model": "openrouter/x-ai/grok-4.20",
      "prompt": "{file:./.opencode/prompts/grok-reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
