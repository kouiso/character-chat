# Local development: copy to .dev.vars.
# Production secrets: use `wrangler secret put`.

AUTH_TOKEN=change-me-local-dev-token
OPENROUTER_API_KEY=sk-or-v1-xxxx
NOVITA_API_KEY=xxxx
RUNWARE_API_KEY=
IMAGE_PROVIDER=novita
IMAGE_PROVIDER_PRIMARY=novita
IMAGE_PROVIDER_FALLBACK=runware

# Cloudflare Access JWT verification in production.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=

# Optional: Slack incoming webhook for API/GitHub Actions error notifications.
# Production: wrangler pages secret put SLACK_ERROR_WEBHOOK_URL --project-name adult-ai-chat
SLACK_ERROR_WEBHOOK_URL=
