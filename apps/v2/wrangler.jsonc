{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "adult-ai-v2",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "./public", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adult-ai-db",
      "database_id": "c0ffee00-0000-4000-8000-000000000001",
      "preview_database_id": "c0ffee00-0000-4000-8000-000000000001",
      "migrations_dir": "../../drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "adult-ai-images" }],
  "env": {
    "remote": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "adult-ai-db",
          "database_id": "c0ffee00-0000-4000-8000-000000000001",
          "remote": true
        }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "adult-ai-images", "remote": true }]
    }
  }
}
