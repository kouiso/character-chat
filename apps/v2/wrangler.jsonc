{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "adult-ai-v2",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "CHAT_ROOMS", "class_name": "ChatRoom" }, { "name": "PROACTIVE_RECIPIENTS", "class_name": "ProactiveRecipient" }] },
  "migrations": [{ "tag": "v2-chat-room-1", "new_sqlite_classes": ["ChatRoom"] }, { "tag": "v2-proactive-recipient-1", "new_sqlite_classes": ["ProactiveRecipient"] }],
  "assets": { "binding": "ASSETS", "directory": "./public", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adult-ai-db",
      "database_id": "c0ffee00-0000-4000-8000-000000000001",
      "preview_database_id": "c0ffee00-0000-4000-8000-000000000001",
      "migrations_dir": "../../drizzle",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "adult-ai-images" }],
  "env": {
    "remote": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "adult-ai-db",
          "database_id": "c0ffee00-0000-4000-8000-000000000001",
          "remote": true,
        },
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "adult-ai-images", "remote": true }],
    },
  },
}
