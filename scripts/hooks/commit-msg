#!/usr/bin/env bash
# commit-msg hook: 品質影響ファイル変更時に [e2e:] タグがないと警告（非blocking）
#
# インストール: cp scripts/hooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg

COMMIT_MSG=$(cat "$1")

QUALITY_PATTERNS=(
  "src/lib/model.ts"
  "functions/api/\[\[route\]\].ts"
  "functions/api/lib/refusal-detect.ts"
  "functions/api/lib/persona-break-detect.ts"
  "prompt/instructions/"
)

STAGED=$(git diff --cached --name-only 2>/dev/null)
QUALITY_AFFECTED=false

for pattern in "${QUALITY_PATTERNS[@]}"; do
  if echo "$STAGED" | grep -qE "$pattern"; then
    QUALITY_AFFECTED=true
    break
  fi
done

if $QUALITY_AFFECTED && ! echo "$COMMIT_MSG" | grep -qE '\[e2e:'; then
  echo ""
  echo "⚡  Quality Gate Warning: 品質影響ファイルが変更されましたが [e2e:] タグがありません。"
  echo "    pnpm e2e:smoke を実行後、コミット本文に追記してください:"
  echo "      [e2e: score=XX refusals=0 erotic=XX/25]"
  echo "    スキップする場合: [e2e: skipped — <理由>]"
  echo "    (このwarningはblockしません。このままコミット可能です)"
  echo ""
fi

exit 0
