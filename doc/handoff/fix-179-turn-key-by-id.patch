+      return (groupCount.get(group) ?? 0) > 1 ? `${group}:${bubble.id}` : group;
+    }
     if (bubble.pending) return `pending-${bubble.role}`;
     const key = `local-${bubble.role}-${localCount[bubble.role]}`;
     localCount[bubble.role] += 1;
