diff --git a/packages/db/src/test/global-setup.ts b/packages/db/src/test/global-setup.ts
new file mode 100644
index 0000000..0889f4d
--- /dev/null
+++ b/packages/db/src/test/global-setup.ts
@@ -0,0 +1,14 @@
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+// テストが dev の .wrangler/state を共用すると、dev サーバーと SQLITE_BUSY で衝突し、
+// テストの行が dev の会話一覧へ残る（#159）。実行ごとの一時 store を worker 起動前に差し込む。
+// 同時に走る別の実行は別ディレクトリになるので互いに掴み合わない。
+export default async function setup(): Promise<() => Promise<void>> {
+  const root = await mkdtemp(join(tmpdir(), "v2-test-d1-"));
+  process.env.WRANGLER_PERSIST_DIR = root;
+  return async () => {
+    await rm(root, { recursive: true, force: true });
+  };
+}
